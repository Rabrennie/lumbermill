{
  "name": "@rabrennie/lumbermill",
  "version": "0.4.5",
  "description": "Ezpz management of git worktrees",
  "author": "rabrennie",
  "bin": {
    "lm": "./bin/run",
    "lumbermill": "./bin/run"
  },
  "homepage": "https://github.com/rabrennie/lumbermill",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": "https://github.com/rabrennie/lumbermill",
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^5.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oclif/test": "^5.0.3",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "oclif": "^6.0.15",
    "shx": "^0.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "oclif": {
    "bin": "lm",
    "binAliases": [
      "lumbermill"
    ],
    "dirname": "lumbermill",
    "commands": "./dist/commands",
    "plugins": [],
    "topicSeparator": " ",
    "topics": {},
    "hooks": {
      "init": [
        "./dist/hooks/init/check-git-command",
        "./dist/hooks/init/check-first-run"
      ],
      "command_not_found": "./dist/hooks/command_not_found/run-alias-command"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint .",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "test": "vitest run",
    "version": "oclif readme && git add README.md"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": "https://github.com/rabrennie/lumbermill/issues",
  "keywords": [
    "oclif"
  ],
  "types": "dist/index.d.ts"
}
